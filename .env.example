# Copy to .env and fill in. Never commit a real key.
# The assistant reads these from the process environment; it does not load
# .env itself, so export them or use your own loader:
#
#   set -a && source .env && set +a

# --- Live LLM mode (required only for ASSISTANT_MODE=live) ---

# OpenAI
OPENAI_API_KEY=sk-replace-me

# Anthropic (alternative to OPENAI_API_KEY)
# ANTHROPIC_API_KEY=sk-ant-replace-me

# Any OpenAI-compatible server (Ollama, vLLM, LM Studio, gateways)
# LLM_API_KEY=replace-me
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# --- Model selection ---

# LLM_PROVIDER=openai            # openai | anthropic | openai-compatible
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=claude-3-5-haiku-latest
# LLM_MODEL=llama3.1

# --- Spend and reliability caps ---

# LLM_MAX_TOKENS=700             # max tokens per call
# LLM_MAX_CALLS=40               # max calls per session
# LLM_TIMEOUT=30                 # seconds per request

# --- Assistant mode ---

# ASSISTANT_MODE=offline         # offline (NOT an LLM) | live

# --- Reviewer UI ---

# REVIEW_UI_PORT=8765
